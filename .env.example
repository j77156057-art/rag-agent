# ========== LLM Provider ==========
# 可选值: qwen(通义千问) / deepseek / ollama / mock(离线演示，无需任何 key)
LLM_PROVIDER=mock

# 指定模型名（留空则用 provider 默认值）
LLM_MODEL=
# 也可直接在此填 key 覆盖下方专用变量
LLM_API_KEY=

# 各厂商 key（按所用 provider 填写对应的一项）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# ========== Harness 视觉辅助（可选，默认不出网） ==========
# 主模型不支持图片时，使用该 provider/model 生成有界图片观察。
DOCMIND_VISION_PROVIDER=ollama
DOCMIND_VISION_MODEL=
DOCMIND_VISION_BASE_URL=
DOCMIND_VISION_API_KEY=
# 允许未被内置画像识别为视觉模型的兜底模型（默认关闭）
DOCMIND_VISION_ALLOW_UNVERIFIED=0
CHAT_IMAGE_MAX_FILES=4
CHAT_IMAGE_MAX_BYTES=10485760
CHAT_VIDEO_MAX_BYTES=209715200
CHAT_VIDEO_MAX_FRAMES=8

# ========== Embedding ==========
# 可选值: qwen(通义千问 text-embedding-v3) / local(本地兜底，离线可用)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-v3

# ========== 路径与参数 ==========
CHROMA_DIR=./.chroma
COLLECTION_NAME=docmind
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
# RAG: dense / hybrid（默认）/ hybrid_rerank（兼容别名，仍由 DOCMIND_RERANKER 控制）
DOCMIND_RETRIEVAL_MODE=hybrid
DOCMIND_DENSE_WEIGHT=1
DOCMIND_BM25_WEIGHT=1
# BM25 lexical storage: sqlite (incremental postings, production default) /
# snapshot (JSON compatibility fallback) / memory
DOCMIND_LEXICAL_BACKEND=sqlite
# SQLite syncs Chroma only on first use or after an invalidation; queries read term postings.
# heuristic 无额外依赖；sentence_transformers 需要额外安装 Cross-Encoder 模型
DOCMIND_RERANKER=heuristic
# DOCMIND_RERANKER=sentence_transformers
# DOCMIND_RERANKER_MODEL=BAAI/bge-reranker-base
MAX_AGENT_STEPS=8
# 代码类任务与完整项目缺陷审查使用独立的有界预算；普通问答仍使用上面的上限
DOCMIND_CODE_MAX_STEPS=12
DOCMIND_AUDIT_MAX_STEPS=16
# 单条工具结果回填给模型的字符上限；审查任务保留更完整的小型源码文件
OBS_MAX_CHARS=1800
DOCMIND_AUDIT_OBS_MAX_CHARS=2600
# 可选：开放局域网访问时启用 API 鉴权；留空表示本机免鉴权
DOCMIND_API_TOKEN=

# ========== Agent 账本 / 会话 / 弹性 ==========
# 逐轮 trace（token 账本）开关与落盘上限；查看页 /trace
DOCMIND_TRACE=1
## Optional LangSmith observability (disabled by default; metadata only)
# DOCMIND_LANGSMITH=1
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=docmind
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# 实时 root/child run 启用后，终态默认不再重复导出事件账本；需要兼容旧面板时显式开启
# DOCMIND_LANGSMITH_EXPORT_FALLBACK=1
# 仅用于真实联调 smoke test；需要同时提供 LANGCHAIN_API_KEY
# DOCMIND_LANGSMITH_LIVE=1
# 固定游戏工作流 dataset 名称；同步仍需显式调用 dataset/sync
# DOCMIND_LANGSMITH_DATASET=docmind-game-workflows
# 本地回归门默认要求的通过率
DOCMIND_WORKFLOW_MIN_PASS_RATE=1.0
DOCMIND_TRACE_MAX_BYTES=8388608
# LangGraph checkpoint backend: set a Postgres DSN for multi-worker use;
# leave empty to use the local SQLite saver.
# DOCMIND_CHECKPOINT_POSTGRES_DSN=postgresql://user:password@localhost:5432/docmind
# DOCMIND_CHECKPOINT_POOL_SIZE=4
# 生产严格模式：Postgres 初始化失败时启动失败，不回退 SQLite
# DOCMIND_CHECKPOINT_POSTGRES_REQUIRED=1
# Lease duration for multi-worker workflow execution.
DOCMIND_WORKFLOW_LEASE_S=120
# Resume approved workflow executions during API startup.
DOCMIND_WORKFLOW_AUTO_RECOVER=1
# 五层上下文压缩队列：默认原子 JSON，避免 Windows/Python 3.13 的 SQLite 原生线程问题。
# 多进程部署可显式切换 sqlite；后台异步 worker 也必须显式打开。
DOCMIND_CONTEXT_COMPRESSION_BACKEND=json
DOCMIND_CONTEXT_COMPRESSION_ASYNC=0
# 会话持久化：超阈值把早期轮次压缩进摘要，只留最近 KEEP 轮原文
DOCMIND_SESSION_MAX_TURNS=12
DOCMIND_SESSION_KEEP_TURNS=6
DOCMIND_SESSION_MAX_CHARS=8000
# 单轮总截止时间（秒；0=不限时）
DOCMIND_TURN_DEADLINE_S=0
# LLM 调用：单次超时 / 总尝试次数 / 指数退避基数（秒）
DOCMIND_LLM_TIMEOUT=180
DOCMIND_LLM_RETRIES=3
DOCMIND_LLM_RETRY_BASE=0.8
# 联网研究质量/样本预算：低相关结果会触发换关键词、年份、平台的继续检索
DOCMIND_WEB_SEARCH_FAIL_LIMIT=6
DOCMIND_WEB_SEARCH_TOTAL_LIMIT=8
DOCMIND_WEB_RESEARCH_MAX_SOURCES=5

# ========== 工具通道 / 子代理 / 计划模式 ==========
# react(默认,文本协议) / native(原生 function-calling) / auto(按 provider 自动)
DOCMIND_TOOL_MODE=react
DOCMIND_SUBAGENT_MAX_DEPTH=2
DOCMIND_SUBAGENT_MAX_STEPS=4
# 并行工具批次：一轮多条只读调用并发执行（含写/副作用工具的批次自动退回顺序）
DOCMIND_PARALLEL_TOOLS=1
DOCMIND_PARALLEL_MAX=4
# 本地 Ollama/llama.cpp 的 LLM 推理槽位默认 1，避免多个 clone 争抢显存；
# 有实测余量时才提高。子代理任务数与推理槽位分开限制。
DOCMIND_LOCAL_LLM_MAX_CONCURRENCY=1
DOCMIND_LOCAL_SUBAGENT_MAX=2
# 多代理编排：任务图最多多少个任务（orchestrate 工具 / POST /api/orchestrate）
DOCMIND_ORCH_MAX_TASKS=12
# 动态重规划：任务失败后最多追加几次补救任务（0 = 关闭重规划）
DOCMIND_ORCH_MAX_REPLANS=2
# 子代理执行轨迹回传（喂给 replanner 归因）：保留步数 / 每步观察截断字数
DOCMIND_ORCH_TRACE_STEPS=6
DOCMIND_ORCH_TRACE_OBS_CHARS=240

# ========== 成本熔断（元；0=不限）==========
# 单价表可用 .docmind_pricing.json 覆盖；本地 provider(ollama/llamacpp/mock) 恒为 0
DOCMIND_BUDGET_CNY=0
DOCMIND_SESSION_BUDGET_CNY=0

# ========== 热插拔目录 ==========
# 钩子：.docmind/hooks/*.py（pre/post_tool、pre/post_turn）；技能：.docmind/skills/**/*.md
DOCMIND_HOOKS_DIR=
DOCMIND_SKILLS_DIR=

# ========== 进阶：文件位置与上限（一般不用改）==========
# 账本/会话/单价表/预算账本的落盘位置（留空=默认落在 BASE_DIR 下，已被 .gitignore 排除）
DOCMIND_TRACE_FILE=
DOCMIND_SESSIONS_DIR=
DOCMIND_PRICING_FILE=
DOCMIND_BUDGET_FILE=
# 技能目录注入系统提示的条数上限 / 单个技能正文回传上限（字符）
DOCMIND_SKILL_CATALOG_MAX=20
DOCMIND_SKILL_BODY_MAX=6000
# 单条 trace 记录落盘前是否压缩（0=关闭自动轮转阈值调整）；留空用默认 8MB
DOCMIND_TRACE_MAX_BYTES=8388608
